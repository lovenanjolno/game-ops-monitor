# minimax LLM API (兼容 OpenAI 协议)
# ⚠️ base_url 必须跟 key 来源平台匹配：
# - 国内 platform.minimaxi.com  → https://api.minimaxi.com/v1
# - 国际 platform.minimax.io  → https://api.minimax.io/v1
MINIMAX_API_KEY=sk-xxxxx
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 如果你的 key 来自 platform.minimax.io（国际版），改上面这行为：
# MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.5

# Discord Bot (后续接入时填)
# DISCORD_BOT_TOKEN=xxxxx
